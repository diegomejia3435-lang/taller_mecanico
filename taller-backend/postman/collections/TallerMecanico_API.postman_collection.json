							"pm.test('Status code es 200 OK', function () {",
							"    pm.response.to.have.status(200);",
							"});",
							"var data = pm.response.json();",
							"pm.test('Token JWT generado correctamente', function () {",
							"    pm.expect(data.token || data.accessToken).to.exist;",
							"});",
