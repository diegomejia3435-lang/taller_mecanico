					"script": {
						"exec": [
							"pm.test('Status code es 201 Created', function () {",
							"    pm.response.to.have.status(201);",
							"});",
							"pm.test('Header Location esta presente y contiene /api/clientes', function () {",
							"    pm.expect(pm.response.headers.get('Location')).to.exist;",
							"    pm.expect(pm.response.headers.get('Location')).to.include('/api/clientes/');",
							"});",
							"var data = pm.response.json();",
							"pm.test('Cliente creado retorna un ID valido', function () {",
							"    pm.expect(data.id).to.be.a('number');",
							"});",
							"pm.collectionVariables.set('clienteId', data.id);"
						],
						"type": "text/javascript"
					}
				}
			],
			"request": {
				"method": "POST",
				"header": [
					{
						"key": "Content-Type",
						"value": "application/json"
